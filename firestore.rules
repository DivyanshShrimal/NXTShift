rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────────
    // Helper Functions for Secure Authentication, Ownership, Role & Access Control
    // ─────────────────────────────────────────────────────────────────────────────

    // Checks that the incoming request is from a valid, authenticated Firebase user
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    // Checks that the authenticated user owns the document path
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Validates per-user duty schema and ownership
    function isValidDutyData(data, uid) {
      return data.ownerUid == uid
          && data.id is string
          && data.dutyDate is string
          && data.shiftType is string
          && data.status is string
          && data.updatedAt is number;
    }

    // Role-based admin authorization check:
    // Requires authenticated user and either a custom claim or entry in /admins collection.
    // Client-side role claims or request data fields are NEVER trusted as the security boundary.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Checks whether the application is globally enabled for online operations.
    // Fails closed if the /app_control/global document is missing, disabled, or invalid.
    function isGlobalEnabled() {
      return exists(/databases/$(database)/documents/app_control/global)
          && get(/databases/$(database)/documents/app_control/global).data.enabled == true;
    }

    // Checks whether the specific authenticated user has not had their remote access revoked.
    // If no /app_access/{uid} document exists, the user is permitted by default.
    // If a document exists, its 'enabled' field must not be false.
    function isUserAccessAllowed(uid) {
      return !exists(/databases/$(database)/documents/app_access/$(uid))
          || get(/databases/$(database)/documents/app_access/$(uid)).data.enabled == true;
    }

    // Combined server-side gate for protected cloud reads and writes.
    function isAccessPermitted(uid) {
      return isGlobalEnabled() && isUserAccessAllowed(uid);
    }

    // Validates central monthly roster schema, versioning, status constraints,
    // and enforces that publishedByUid strictly matches the authenticated admin's UID.
    function isValidMonthlyRoster(data, rosterId) {
      return data.id == rosterId
          && data.year is number && data.year >= 2020 && data.year <= 2100
          && data.month is number && data.month >= 1 && data.month <= 12
          && data.status in ['DRAFT', 'PUBLISHED']
          && data.version is number && data.version >= 1
          && data.updatedAt is number
          && (data.status != 'PUBLISHED' || (data.publishedAt is number && data.publishedByUid == request.auth.uid));
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 1. Admin Authorization Collection: /admins/{adminUid}
    // ─────────────────────────────────────────────────────────────────────────────
    // - Any authenticated user can get their own document to check if they are an admin.
    // - Only admins can list the admin collection (prevents normal users from enumerating admin UIDs).
    // - Writes are COMPLETELY DISABLED from all client apps (managed exclusively via Firebase Console or Admin SDK).
    // - Clients can NEVER grant themselves or others administrator privileges.
    match /admins/{adminUid} {
      allow get: if isAuthenticated() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 2. Remote Access Control Collections: /app_control and /app_access
    // ─────────────────────────────────────────────────────────────────────────────
    // Global application availability control
    match /app_control/global {
      allow get: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Individual user access / revocation records
    match /app_access/{targetUid} {
      allow get: if isAuthenticated() && (request.auth.uid == targetUid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 3. Central Monthly Roster Collection: /monthly_rosters/{rosterId}
    // ─────────────────────────────────────────────────────────────────────────────
    // - Authenticated users can read published rosters when global access is enabled and user is not revoked.
    // - Only verified admins can read drafts, create, update, publish, or delete central rosters.
    // - All mutations and publishing are blocked when global access is disabled.
    match /monthly_rosters/{rosterId} {
      allow get: if isAuthenticated() && isAccessPermitted(request.auth.uid) && (
        resource == null || resource.data.status == 'PUBLISHED' || isAdmin()
      );
      allow list: if isAuthenticated() && isAccessPermitted(request.auth.uid) && (
        resource.data.status == 'PUBLISHED' || isAdmin()
      );
      allow create, update: if isAdmin() && isGlobalEnabled() && isValidMonthlyRoster(request.resource.data, rosterId);
      allow delete: if isAdmin() && isGlobalEnabled();
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 4. User Isolated Root Document & Profile: /users/{uid} (PRESERVED & GATED)
    // ─────────────────────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid) && isAccessPermitted(uid);

      // User Profile sub-document
      match /profile/{profileDoc} {
        allow read, write: if isOwner(uid) && isAccessPermitted(uid);
      }

      // User Isolated Duties Collection
      match /duties/{dutyId} {
        allow read: if isOwner(uid) && isAccessPermitted(uid);
        allow create: if isOwner(uid) && isAccessPermitted(uid)
                      && isValidDutyData(request.resource.data, uid)
                      && request.resource.data.id == dutyId;
        allow update: if isOwner(uid) && isAccessPermitted(uid)
                      && isValidDutyData(request.resource.data, uid)
                      && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isOwner(uid) && isAccessPermitted(uid);
      }

      // Roster Imports log
      match /rosterImports/{importId} {
        allow read, write: if isOwner(uid) && isAccessPermitted(uid);
      }

      // User Staff Directory
      match /staff/{staffId} {
        allow read, write: if isOwner(uid) && isAccessPermitted(uid);
      }

      // User Settings and Preferences
      match /settings/{settingsDoc} {
        allow read, write: if isOwner(uid) && isAccessPermitted(uid);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────────
    // 5. Default Deny Catch-All (PRESERVED)
    // ─────────────────────────────────────────────────────────────────────────────
    // Deny access by default to any other unmatched collection or document
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
