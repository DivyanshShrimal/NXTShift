<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStaffItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/bg_card"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Select Radio + Name + Count Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/rbSelectStaff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:buttonTint="@color/brand_accent"
                android:focusable="false"
                android:clickable="false" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="4dp"
                android:layout_toEndOf="@id/rbSelectStaff"
                android:layout_toStartOf="@id/tvStaffDutyCount"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvStaffName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:textColor="@color/brand_primary"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvProfileMatch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/bg_badge_rounded"
                    android:backgroundTint="@color/brand_accent_light"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="1dp"
                    android:text="⭐ Matches your profile"
                    android:textColor="@color/shift_general_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStaffDutyCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/shift_morning_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="22 shifts"
                android:textColor="@color/shift_morning_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Divider line -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="@color/border_light" />

        <!-- Actions Row: Edit, Split, Merge, Remove -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- Edit Spelling -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditStaff"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="8dp"
                android:text="Edit"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <!-- Split Combined Name -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSplitStaff"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="8dp"
                android:text="Split"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <!-- Merge Duplicate -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMergeStaff"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="8dp"
                android:text="Merge"
                android:textColor="@color/brand_primary"
                android:textSize="12sp" />

            <!-- Delete / Not a Person -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDeleteStaff"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:paddingHorizontal="8dp"
                android:text="Not Person"
                android:textColor="@color/shift_off_text"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
