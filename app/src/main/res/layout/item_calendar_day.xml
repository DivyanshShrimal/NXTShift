<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="2dp">

    <!-- Day Number Text -->
    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <!-- Indicator slot directly below date number -->
    <FrameLayout
        android:id="@+id/layoutIndicatorContainer"
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="1dp">

        <!-- Shift Indicator Dot for working shifts -->
        <View
            android:id="@+id/viewShiftDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_badge_rounded"
            android:backgroundTint="@color/shift_morning"
            android:visibility="invisible" />

        <!-- Leave Indicator: small red capital letter L directly below date number -->
        <TextView
            android:id="@+id/tvLeaveIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="sans-serif-bold"
            android:includeFontPadding="false"
            android:text="L"
            android:textColor="@color/shift_off"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
