<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Card Container -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/bg_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeColor="@color/border_light"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Status Icon -->
            <ImageView
                android:id="@+id/ivRestrictedIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:contentDescription="Access Status"
                android:src="@drawable/ic_warning"
                app:tint="@color/brand_primary" />

            <!-- Title -->
            <TextView
                android:id="@+id/tvRestrictedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:text="Cloud Access Suspended"
                android:textColor="@color/brand_primary"
                android:textSize="20sp" />

            <!-- Subtitle / Badge -->
            <TextView
                android:id="@+id/tvRestrictedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="REMOTE ACCESS CONTROL"
                android:textColor="@color/shift_general_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Detailed Message -->
            <TextView
                android:id="@+id/tvRestrictedMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="sans-serif"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:text="Application access is currently unavailable. Cloud synchronization is suspended."
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <!-- Offline Safety Note -->
            <TextView
                android:id="@+id/tvOfflineNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_badge_rounded"
                android:fontFamily="sans-serif"
                android:padding="12dp"
                android:text="💡 Your local shifts are safe: You can continue to view your saved duties and monthly calendar in offline mode."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <!-- Action: View Offline Calendar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewOfflineCalendar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="View Offline Calendar"
                android:textAllCaps="false"
                app:cornerRadius="8dp" />

            <!-- Action: Re-check Access -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetryAccess"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Recheck Connection &amp; Access"
                android:textAllCaps="false"
                app:cornerRadius="8dp" />

            <!-- Action: Sign Out -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSignOut"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sign Out"
                android:textAllCaps="false"
                android:textColor="@color/status_error" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
