<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. Enforces consistent Light mode across all devices. -->
    <style name="Theme.NXTShift" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color (Midnight Navy). -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_variant</item>
        <item name="colorOnPrimary">@color/text_on_dark</item>

        <!-- Secondary brand color (Mint Green Accent). -->
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorSecondaryVariant">@color/brand_accent_variant</item>
        <item name="colorOnSecondary">@color/brand_primary</item>

        <!-- Status bar & Navigation bar with dark icons on light background -->
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>

        <!-- Window & Surface Backgrounds -->
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:colorBackground">@color/bg_light</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Text Colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:editTextColor">@color/text_primary</item>

        <!-- Disable Android 10+ automatic Force Dark -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <!-- Material Components explicit styles -->
        <item name="textInputStyle">@style/Widget.NXTShift.TextInputLayout</item>
        <item name="materialButtonStyle">@style/Widget.NXTShift.Button</item>
        <item name="materialCardViewStyle">@style/Widget.NXTShift.CardView</item>

        <!-- Dialogs -->
        <item name="alertDialogTheme">@style/Theme.NXTShift.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.NXTShift.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.NXTShift.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.NXTShift.Dialog</item>
    </style>

    <!-- Outlined TextInputLayout Style -->
    <style name="Widget.NXTShift.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="boxStrokeColor">@color/sl_box_stroke</item>
        <item name="boxStrokeWidth">1.5dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxBackgroundColor">@color/bg_card</item>
        <item name="hintTextColor">@color/sl_text_input_hint</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="placeholderTextColor">@color/text_muted</item>
        <item name="helperTextTextColor">@color/text_secondary</item>
        <item name="errorTextColor">@color/status_error</item>
        <item name="endIconTint">@color/text_secondary</item>
        <item name="startIconTint">@color/text_secondary</item>
    </style>

    <!-- Material Button Style -->
    <style name="Widget.NXTShift.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Material CardView Style -->
    <style name="Widget.NXTShift.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">1dp</item>
        <item name="strokeColor">@color/border_light</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Explicit Light Dialog Theme -->
    <style name="Theme.NXTShift.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="android:background">@color/bg_card</item>
        <item name="colorSurface">@color/bg_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.NXTShift.DialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.NXTShift.DialogButton</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Widget.NXTShift.DialogButton" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/brand_accent_variant</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
